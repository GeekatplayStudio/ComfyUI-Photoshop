{
    "manifestVersion": 5,
    "id": "com.geekatplay.photoshop-comfyui-bridge",
    "name": "Geekatplay ComfyUI Bridge",
    "version": "1.1.0",
    "main": "index.html",
    "host": {
        "app": "PS",
        "minVersion": "25.0.0"
    },
    "entrypoints": [
        {
            "type": "panel",
            "id": "comfyuiBridge",
            "label": { "default": "ComfyUI Bridge" },
            "minimumSize": { "width": 240, "height": 320 },
            "maximumSize": { "width": 2000, "height": 4000 },
            "preferredDockedSize": { "width": 300, "height": 560 },
            "preferredFloatingSize": { "width": 320, "height": 600 },
            "icons": [
                { "width": 23, "height": 23, "path": "icons/panel-dark.png", "scale": [1, 2], "theme": ["darkest", "dark", "medium"], "species": ["chrome"] },
                { "width": 23, "height": 23, "path": "icons/panel-light.png", "scale": [1, 2], "theme": ["lightest", "light"], "species": ["chrome"] }
            ]
        }
    ],
    "icons": [
        { "width": 48, "height": 48, "path": "icons/plugin.png", "scale": [1, 2], "theme": ["all"], "species": ["pluginList"] }
    ],
    "requiredPermissions": {
        "network": { "domains": "all" },
        "localFileSystem": "request",
        "clipboard": "readAndWrite"
    }
}
